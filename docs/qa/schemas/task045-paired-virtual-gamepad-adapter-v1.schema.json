{
  "$id": "docs/qa/schemas/task045-paired-virtual-gamepad-adapter-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TASK-045 paired TV and phone local-only adapter",
  "description": "Typed local-only input. Python semantic validation additionally enforces scenario-specific paired, freshness, recovery, boundary, cleanup and redaction invariants.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "modality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_id": {"$ref": "#/$defs/safeId"},
        "captured_at_utc": {"$ref": "#/$defs/timestamp"},
        "visual_inspection": {"type": "boolean"}
      },
      "required": ["evidence_id", "captured_at_utc"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lane_alias": {"enum": ["phone-xiaomi-007", "phone-samsung-002", "phone-realme-001", "tv-tpv-013"]},
        "profile_alias": {"enum": ["phone-xiaomi-a13-007", "phone-samsung-a13-002", "phone-realme-a16-001", "tv-tpv-a12-013"]},
        "apk_family": {"enum": ["phone-full", "television-full"]},
        "form_factor": {"enum": ["phone", "tv"]},
        "physical": {"const": true},
        "present": {"type": "boolean"}
      },
      "required": ["lane_alias", "profile_alias", "apk_family", "form_factor", "physical", "present"]
    },
    "sidePreflight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["READY", "BLOCKED"]},
        "adb_authorized": {"type": "boolean"},
        "artifact_present": {"type": "boolean"},
        "family_confirmed": {"type": "boolean"},
        "owner_declared_available": {"type": "boolean"},
        "reason_code": {"$ref": "#/$defs/safeId"}
      },
      "required": ["status", "adb_authorized", "artifact_present", "family_confirmed", "owner_declared_available", "reason_code"]
    },
    "blocker": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["blocked_by_device", "blocked_by_fixture", "blocked_by_oracle", "blocked_by_product_boundary", "blocked_by_external_state"]},
        "reason_code": {"$ref": "#/$defs/safeId"}
      },
      "required": ["status", "reason_code"]
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boundary_id": {"$ref": "#/$defs/safeId"},
        "scenario_id": {"type": "string", "pattern": "^QA-045-[0-9]{3}$"},
        "attempt_id": {"$ref": "#/$defs/safeId"},
        "category": {"enum": ["payment", "session", "account", "network", "qr", "none"]},
        "reached": {"type": "boolean"},
        "external_action_performed": {"const": false},
        "qr_traversed": {"const": false},
        "mutation_performed": {"const": false},
        "recovery_result": {"enum": ["not_required", "pass", "fail"]},
        "evidence_status": {"enum": ["confirmed", "likely", "hypothesis", "unknown"]}
      },
      "required": ["boundary_id", "scenario_id", "attempt_id", "category", "reached", "external_action_performed", "qr_traversed", "mutation_performed", "recovery_result", "evidence_status"]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempt_id": {"$ref": "#/$defs/safeId"},
        "started_at_utc": {"$ref": "#/$defs/timestamp"},
        "completed_at_utc": {"$ref": "#/$defs/timestamp"},
        "lane_scope": {"enum": ["phone_independent", "paired", "tv"]},
        "phone_alias": {"enum": ["phone-xiaomi-007", "phone-samsung-002", "phone-realme-001"]},
        "phone_apk_family": {"const": "phone-full"},
        "tv_alias": {"const": "tv-tpv-013"},
        "tv_apk_family": {"const": "television-full"},
        "pre_state_alias": {"$ref": "#/$defs/safeId"},
        "action_category": {"$ref": "#/$defs/safeId"},
        "observed_state_alias": {"$ref": "#/$defs/safeId"},
        "oracle_result": {"enum": ["pass", "fail", "blocked", "not_observed"]},
        "evidence_type": {"enum": ["physical_runtime", "paired_physical_runtime", "static_contract", "manual_observation"]},
        "evidence_status": {"enum": ["confirmed", "likely", "hypothesis", "unknown"]},
        "paired_state_observed": {"type": "boolean"},
        "modalities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "screenshot": {"allOf": [{"$ref": "#/$defs/modality"}, {"properties": {"visual_inspection": {"const": true}}, "required": ["visual_inspection"]}]},
            "ui_tree": {"$ref": "#/$defs/modality"},
            "runner_log": {"$ref": "#/$defs/modality"}
          },
          "required": ["screenshot", "ui_tree", "runner_log"]
        },
        "recovery_attempt": {"type": "boolean"},
        "recovery_of_attempt_id": {"$ref": "#/$defs/safeId"},
        "cleanup_id": {"$ref": "#/$defs/safeId"},
        "boundary_id": {"$ref": "#/$defs/safeId"}
      },
      "required": ["attempt_id", "started_at_utc", "completed_at_utc", "lane_scope", "phone_alias", "phone_apk_family", "tv_alias", "tv_apk_family", "pre_state_alias", "action_category", "observed_state_alias", "oracle_result", "evidence_type", "evidence_status", "paired_state_observed", "modalities", "recovery_attempt", "recovery_of_attempt_id", "cleanup_id", "boundary_id"]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^QA-045-[0-9]{3}$"},
        "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
        "blocker": {"$ref": "#/$defs/blocker"}
      },
      "required": ["scenario_id", "attempts", "blocker"]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage_id": {"$ref": "#/$defs/safeId"},
        "branch_alias": {"$ref": "#/$defs/safeId"},
        "lane_scope": {"enum": ["disconnected_independent", "paired_required"]},
        "approved_scope": {"type": "boolean"},
        "declared_reachable": {"type": "boolean"},
        "discovered": {"type": "boolean"},
        "requires_connected_pair": {"type": "boolean"},
        "status": {"enum": ["covered", "blocked_by_boundary", "blocked_by_tooling", "blocked_by_external_state", "not_run_out_of_scope"]},
        "screen_alias": {"$ref": "#/$defs/safeId"},
        "state_category": {"$ref": "#/$defs/safeId"},
        "focus_action_category": {"$ref": "#/$defs/safeId"},
        "evidence_status": {"enum": ["confirmed", "likely", "hypothesis", "unknown"]},
        "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/safeId"}},
        "reason_code": {"$ref": "#/$defs/safeId"}
      },
      "required": ["coverage_id", "branch_alias", "lane_scope", "approved_scope", "declared_reachable", "discovered", "requires_connected_pair", "status", "screen_alias", "state_category", "focus_action_category", "evidence_status", "evidence_ids", "reason_code"]
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {"$ref": "#/$defs/safeId"},
        "scenario_id": {"type": "string", "pattern": "^QA-045-[0-9]{3}$"},
        "observed_at_utc": {"$ref": "#/$defs/timestamp"},
        "side": {"enum": ["phone", "tv", "pair"]},
        "state_alias": {"$ref": "#/$defs/safeId"},
        "attempt_id": {"$ref": "#/$defs/safeId"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/safeId"}}
      },
      "required": ["event_id", "scenario_id", "observed_at_utc", "side", "state_alias", "attempt_id", "evidence_ids"]
    },
    "anomaly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anomaly_id": {"$ref": "#/$defs/safeId"},
        "scenario_id": {"type": "string", "pattern": "^QA-045-[0-9]{3}$"},
        "attempt_id": {"$ref": "#/$defs/safeId"},
        "trigger_category": {"$ref": "#/$defs/safeId"},
        "expected_result_category": {"$ref": "#/$defs/safeId"},
        "observed_result_category": {"$ref": "#/$defs/safeId"},
        "public_safe_screen_alias": {"$ref": "#/$defs/safeId"},
        "classification": {"enum": ["observed_fail", "confirmed_defect", "tooling_defect"]},
        "evidence_status": {"const": "confirmed"},
        "cause_evidence_status": {"enum": ["confirmed", "likely", "hypothesis", "unknown"]},
        "cause_category": {"$ref": "#/$defs/safeId"},
        "test_design_implication": {"$ref": "#/$defs/safeId"},
        "first_failure_retained": {"const": true},
        "reason_code": {"$ref": "#/$defs/safeId"}
      },
      "required": ["anomaly_id", "scenario_id", "attempt_id", "trigger_category", "expected_result_category", "observed_result_category", "public_safe_screen_alias", "classification", "evidence_status", "cause_evidence_status", "cause_category", "test_design_implication", "first_failure_retained", "reason_code"]
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cleanup_id": {"$ref": "#/$defs/safeId"},
        "scenario_id": {"type": "string", "pattern": "^QA-045-[0-9]{3}$"},
        "attempt_id": {"$ref": "#/$defs/safeId"},
        "action_category": {"$ref": "#/$defs/safeId"},
        "result": {"enum": ["pass", "fail", "not_required"]},
        "kill_switch_ready": {"type": "boolean"},
        "rollback_verified": {"type": "boolean"},
        "evidence_status": {"enum": ["confirmed", "likely", "hypothesis", "unknown"]}
      },
      "required": ["cleanup_id", "scenario_id", "attempt_id", "action_category", "result", "kill_switch_ready", "rollback_verified", "evidence_status"]
    },
    "inventoryAnomaly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anomaly_id": {"$ref": "#/$defs/safeId"},
        "category": {"enum": ["process_anomaly", "runtime_anomaly"]},
        "classification": {"enum": ["tooling_defect", "observed_fail", "blocked_by_fixture", "blocked_by_external_state", "blocked_by_product_boundary"]},
        "evidence_status": {"const": "confirmed"},
        "trigger_category": {"$ref": "#/$defs/safeId"},
        "expected_result_category": {"$ref": "#/$defs/safeId"},
        "observed_result_category": {"$ref": "#/$defs/safeId"},
        "public_safe_screen_alias": {"$ref": "#/$defs/safeId"},
        "cause_evidence_status": {"enum": ["confirmed", "likely", "hypothesis", "unknown"]},
        "cause_category": {"$ref": "#/$defs/safeId"},
        "test_design_implication": {"$ref": "#/$defs/safeId"},
        "first_failure_retained": {"const": true},
        "reason_code": {"$ref": "#/$defs/safeId"}
      },
      "required": ["anomaly_id", "category", "classification", "evidence_status", "trigger_category", "expected_result_category", "observed_result_category", "public_safe_screen_alias", "cause_evidence_status", "cause_category", "test_design_implication", "first_failure_retained", "reason_code"]
    },
    "inventoryCleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cleanup_id": {"$ref": "#/$defs/safeId"},
        "target_app_force_stopped": {"type": "boolean"},
        "home_restored": {"type": "boolean"},
        "external_browser_opened": {"const": false},
        "payment_or_session_started": {"const": false},
        "account_mutated": {"const": false},
        "network_changed": {"const": false},
        "paired_state_observed": {"const": false},
        "existing_session_preserved": {"type": "boolean"},
        "evidence_status": {"const": "confirmed"}
      },
      "required": ["cleanup_id", "target_app_force_stopped", "home_restored", "external_browser_opened", "payment_or_session_started", "account_mutated", "network_changed", "paired_state_observed", "existing_session_preserved", "evidence_status"]
    }
  },
  "properties": {
    "schema_version": {"const": "task045-paired-runtime-adapter-v1"},
    "run_id": {"$ref": "#/$defs/safeId"},
    "generated_at_utc": {"$ref": "#/$defs/timestamp"},
    "scenario_contract_version": {"const": "task045-scenarios-v1"},
    "build_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alias": {"$ref": "#/$defs/safeId"},
        "phone_apk_family": {"const": "phone-full"},
        "tv_apk_family": {"const": "television-full"},
        "installed_lane_alias": {"$ref": "#/$defs/safeId"},
        "canonical_bundle_alias": {"$ref": "#/$defs/safeId"},
        "canonical_install_outcome": {"const": "blocked_version_downgrade"},
        "compatibility_evidence_status": {"const": "unknown"},
        "raw_hash_published": {"const": false}
      },
      "required": ["alias", "phone_apk_family", "tv_apk_family", "installed_lane_alias", "canonical_bundle_alias", "canonical_install_outcome", "compatibility_evidence_status", "raw_hash_published"]
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"phone": {"$ref": "#/$defs/target"}, "tv": {"$ref": "#/$defs/target"}},
      "required": ["phone", "tv"]
    },
    "runtime_preflight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["READY", "PARTIAL_BLOCKED", "BLOCKED"]},
        "phone": {"$ref": "#/$defs/sidePreflight"},
        "tv": {"$ref": "#/$defs/sidePreflight"},
        "synthetic_fixture_ready": {"type": "boolean"},
        "ignored_evidence_storage_ready": {"type": "boolean"},
        "cleanup_rollback_ready": {"type": "boolean"},
        "reviewer_gate": {"type": "boolean"},
        "inventory_declaration_complete": {"type": "boolean"},
        "inventory_discovered_branch_count": {"type": "integer", "minimum": 0},
        "inventory_approved_reachable_branch_count": {"type": "integer", "minimum": 0},
        "session_provenance": {"enum": ["approved_synthetic_fixture", "unknown_not_verified"]},
        "session_dependent_evidence_eligible": {"type": "boolean"}
      },
      "required": ["status", "phone", "tv", "synthetic_fixture_ready", "ignored_evidence_storage_ready", "cleanup_rollback_ready", "reviewer_gate", "inventory_declaration_complete", "inventory_discovered_branch_count", "inventory_approved_reachable_branch_count", "session_provenance", "session_dependent_evidence_eligible"]
    },
    "scenarios": {"type": "array", "minItems": 22, "maxItems": 22, "items": {"$ref": "#/$defs/scenario"}},
    "phone_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverage"}},
    "paired_timeline": {"type": "array", "items": {"$ref": "#/$defs/timeline"}},
    "anomalies": {"type": "array", "items": {"$ref": "#/$defs/anomaly"}},
    "inventory_anomalies": {"type": "array", "items": {"$ref": "#/$defs/inventoryAnomaly"}},
    "inventory_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/safeId"}},
    "inventory_cleanup": {"$ref": "#/$defs/inventoryCleanup"},
    "boundaries": {"type": "array", "items": {"$ref": "#/$defs/boundary"}},
    "cleanup": {"type": "array", "items": {"$ref": "#/$defs/cleanup"}}
  },
  "required": ["schema_version", "run_id", "generated_at_utc", "scenario_contract_version", "build_ref", "targets", "runtime_preflight", "scenarios", "phone_coverage", "paired_timeline", "anomalies", "inventory_anomalies", "inventory_evidence_ids", "inventory_cleanup", "boundaries", "cleanup"]
}
